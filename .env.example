# Copy to .env and fill in the one secret. .env is gitignored.
#   cp .env.example .env
#
# docker compose up -d   reads this file for the container passwords.
# python -m core.entrypoint ...   reads the same file for the app.
# The passwords below are local-only. They must match on both sides.

ENV=local_env

# Keep this false for the localhost containers. true rewrites Neo4j, Mongo,
# and Qdrant onto the EC2_* endpoints and requires every one of them.
USE_EC2_DATABASES=false

# --- Neo4j (graph) ---
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=local-dev-password
# docker-compose.yml sets the container's auth from this. Must equal NEO4J_PASSWORD.
EC2_NEO4J_PASSWORD=local-dev-password

# --- MongoDB (checkpoints) ---
MONGO_URI=mongodb://root:local-dev-password@localhost:27017/?authSource=admin
MONGO_DB=graph_ingestion_checkpoints_dev
# docker-compose.yml creates the root user from these. The password must be
# the one embedded in MONGO_URI.
MONGO_ROOT_PASSWORD=local-dev-password
EC2_MONGO_DB=graph_ingestion_checkpoints_dev

# --- Qdrant (entity and chunk embeddings) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev-qdrant-key
# docker-compose.yml sets the container's API key from this. Must equal QDRANT_API_KEY.
EC2_QDRANT_API_KEY=local-dev-qdrant-key

# --- LLM and embeddings. One switch covers chat and embeddings. ---
# nvidia   NVIDIA NIM. Paste a free key from https://build.nvidia.com below.
# inhouse  self-hosted vLLM on localhost:8000 (chat) and :8001 (embeddings).
#          No key. Overrides of MINISTRAL_URL / MINISTRAL_MODEL /
#          IN_HOUSE_EMBEDDINGS_URL / IN_HOUSE_EMBEDDING_MODEL /
#          IN_HOUSE_EMBEDDING_DIMENSION win over that preset.
INFERENCE_PROVIDER=nvidia

USE_IN_HOUSE_MODEL=true
USE_IN_HOUSE_EMBEDDINGS=true

# Required when INFERENCE_PROVIDER=nvidia. MINISTRAL_API_KEY is the same value.
NVIDIA_API_KEY=

# Sent to Wikipedia and arXiv. Wikimedia returns 403 without a descriptive one.
# HTTP_USER_AGENT=ai-graph-ingestion/1.0 (you@example.com)

# Azure fallback. Only read when USE_IN_HOUSE_MODEL=false (chat) or
# USE_IN_HOUSE_EMBEDDINGS=false (embeddings).
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_COMPLETION_MODEL=gpt-5.4-nano

# Kafka worker only. The Wikipedia and arXiv connectors have no event feed.
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_SECURITY_PROTOCOL=SSL
# AWS_REGION=us-west-2
